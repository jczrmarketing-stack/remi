<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- La noche de la fábrica (mejora 4, 6-nov): 2:30, antes de la noche de Remi (4:00) y de la bóveda.
     Un pedido por corrida: lo aprobado con «aprobar <id> --de-noche», o planear lo encolado.
     Instalar (una vez, después de unir fabrica/bloque-1 a la rama del checkout principal):
       cp scripts/launchd/com.remi.fabrica.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.remi.fabrica.plist
     Apagar: launchctl unload ~/Library/LaunchAgents/com.remi.fabrica.plist -->
<plist version="1.0">
<dict>
<key>Label</key>
<string>com.remi.fabrica</string>
<key>WorkingDirectory</key>
<string>/Users/juancamilo/proyectos/remi/nucleo</string>
<key>ProgramArguments</key>
<array>
<string>/Users/juancamilo/proyectos/remi/nucleo/.venv/bin/python</string>
<string>-m</string>
<string>fabrica</string>
<string>noche</string>
</array>
<key>StartCalendarInterval</key>
<dict>
<key>Hour</key>
<integer>2</integer>
<key>Minute</key>
<integer>30</integer>
</dict>
<key>EnvironmentVariables</key>
<dict>
<key>PATH</key>
<string>/usr/local/bin:/opt/homebrew/bin:/Users/juancamilo/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
<key>HOME</key>
<string>/Users/juancamilo</string>
</dict>
<key>StandardOutPath</key>
<string>/Users/juancamilo/Library/Logs/Remi/fabrica.log</string>
<key>StandardErrorPath</key>
<string>/Users/juancamilo/Library/Logs/Remi/fabrica.log</string>
</dict>
</plist>
